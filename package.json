{
  "name": "agent-chat-room",
  "version": "0.1.0",
  "description": "A local chat room where your installed agent CLIs build and review code together.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elia-dot/agent-chat-room.git"
  },
  "homepage": "https://github.com/elia-dot/agent-chat-room#readme",
  "bugs": {
    "url": "https://github.com/elia-dot/agent-chat-room/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "claude",
    "codex",
    "cursor",
    "opencode",
    "cli",
    "code-review"
  ],
  "bin": {
    "acr": "./packages/cli/dist/bin.js",
    "agent-chat-room": "./packages/cli/dist/bin.js"
  },
  "files": [
    "packages/cli/dist",
    "packages/cli/package.json",
    "packages/core/dist",
    "packages/core/package.json",
    "packages/server/dist",
    "packages/server/package.json",
    "packages/web/dist",
    "!**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.6.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -b && npm -w @agent-chat-room/web run build",
    "prepack": "npm run build",
    "build:ts": "tsc -b",
    "typecheck": "tsc -p tsconfig.eslint.json && tsc -p packages/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "acr": "node packages/cli/dist/bin.js",
    "dev:server": "node packages/cli/dist/bin.js serve --no-open",
    "dev:web": "npm -w @agent-chat-room/web run dev",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "serve": "node packages/cli/dist/bin.js serve"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.4"
  }
}
